# Variáveis de Ambiente — Plataforma de Governança de IA & Risco Financeiro
# Copie este arquivo para .env.local e preencha os valores

# ─── Modo do Agente de IA ───────────────────────────────────────────────────────
# "mock" = modo demo seguro (padrão, sem dependência externa)
# "ollama" = usar LLaMA local via Ollama
# "gemini" = chamar a API Gemini no servidor (requer GEMINI_API_KEY)
AI_AGENT_MODE=mock

# ─── Gemini Developer API ──────────────────────────────────────────────────────
# Coloque a chave somente em .env.local / variáveis privadas do host.
# Nunca use NEXT_PUBLIC_GEMINI_API_KEY e nunca faça commit da chave.
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.8-flash

# ─── Configurações Ollama ────────────────────────────────────────────────────────
# Necessário APENAS quando AI_AGENT_MODE=ollama
# NUNCA use prefixo NEXT_PUBLIC_ — essas variáveis devem ficar server-side
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.2

# ─── Motor de Risco Financeiro ───────────────────────────────────────────────────
# Taxa de câmbio USD → BRL (padrão: 5.60)
# Ajuste conforme necessário ou remova para usar o padrão
RISK_ENGINE_USD_TO_BRL=5.60

# ─── Auditoria ───────────────────────────────────────────────────────────────────
# Chave secreta para derivação de userIds anonimizados
# IMPORTANTE: Use um valor aleatório seguro em produção
# Gere com: openssl rand -hex 32
AUDIT_SECRET_KEY=dev-only-change-in-production-use-openssl-rand-hex-32
